# ─── Anthropic / LLM ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Model names live in config, never hardcoded in logic.
CLAUDE_MODEL_EXTRACT=claude-sonnet-4-5
CLAUDE_MODEL_SYNTH=claude-opus-4-1
CLAUDE_MODEL_VISION=claude-sonnet-4-5

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=service-role-key
# Direct Postgres connection for asyncpg / SQLAlchemy (async driver).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_STORAGE_BUCKET=majak-sources

# ─── Auth (single user) ──────────────────────────────────────────────────────
AUTH_SINGLE_USER_EMAIL=pavol.turcina@gospace.tech
# JWT secret used by Supabase Auth to sign access tokens (for verification).
SUPABASE_JWT_SECRET=super-secret-jwt

# ─── Connectors ──────────────────────────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

FATHOM_API_KEY=

GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GCAL_REFRESH_TOKEN=
GCAL_CALENDAR_ID=primary

# ─── Runtime ─────────────────────────────────────────────────────────────────
TZ=Europe/Bratislava
# Scheduled run times (24h, local TZ): close-and-open, then fill-overnight.
RUN_TIMES=18:00,04:00
# Notification channel for the morning brief: email | slack | push | log
NOTIFY_CHANNEL=log
NOTIFY_TARGET=pavol.turcina@gospace.tech

# ─── Resolution thresholds (people matching) ─────────────────────────────────
PERSON_MATCH_LINK=0.92
PERSON_MATCH_REVIEW=0.75

# ─── Embeddings ──────────────────────────────────────────────────────────────
EMBEDDING_DIM=1024
